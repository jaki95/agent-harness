[Unit]
Description=Recover outstanding upstream adoptions when the private runner starts
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LoadCredential=dispatch.pem:/etc/upstream-adoption/dispatch.pem
ExecStart=/usr/bin/python3 /opt/upstream-adoption/scripts/wake_upstream_operator.py --repo OPERATOR/PRIVATE_REPO --client-id DISPATCH_APP_CLIENT_ID --private-key %d/dispatch.pem
Restart=on-failure
RestartSec=10min
